rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin identificado pelo e-mail no token JWT (server-side) ──
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'sm.servicosetecnologia@gmail.com';
    }

    // ── Verifica se a assinatura do usuário está ativa e dentro do prazo ──
    function isActive(uid) {
      let path = /databases/$(database)/documents/subscriptions/$(uid);
      let now = request.time.toMillis();
      return !exists(path)
        || (get(path).data.status == 'active'
            && (!('expiresAt' in get(path).data) || get(path).data.expiresAt > now))
        || (get(path).data.status == 'trial'
            && 'trialEndsAt' in get(path).data
            && get(path).data.trialEndsAt > now);
    }

    // ── Coleção de assinaturas ──
    match /subscriptions/{userId} {
      // Usuário lê a própria; admin lê todas
      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      // Usuário cria apenas a própria com status 'trial' e trialEndsAt no máximo 16 dias
      allow create: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'trial'
          && request.resource.data.trialEndsAt is int
          && request.resource.data.trialEndsAt <= (request.time.toMillis() + 16 * 24 * 60 * 60 * 1000)
          && request.resource.data.email is string
          && request.resource.data.name is string
          && (!('referredBy' in request.resource.data) || request.resource.data.referredBy is string));

      // Usuário pode atualizar apenas o campo lastLoginAt da própria assinatura
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']);

      // Apenas admin pode suspender, ativar, renovar ou excluir
      allow update, delete: if isAdmin();
    }

    // ── Dados do usuário: exige autenticação + assinatura ativa ──
    match /users/{userId}/{document=**} {
      allow read: if isAdmin()
        || (request.auth != null && request.auth.uid == userId && isActive(userId));
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (isAdmin() || isActive(userId));
    }

    // ── Collection group query: admin lê settings de qualquer usuário ──
    match /{path=**}/settings/{settingId} {
      allow read: if isAdmin();
    }
  }
}
