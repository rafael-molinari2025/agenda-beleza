{
  "hosting": {
    "site": "bella-agenda-226f0",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".gitignore",
      "firestore.rules",
      "agenda-beleza.html",
      "*.bat",
      "*.sh",
      "*.ps1",
      "README.md",
      ".git/**",
      ".claude/**",
      "node_modules/**"
    ],
    "redirects": [
      { "source": "/landing.html", "destination": "/landing", "type": 301 },
      { "source": "/login.html",   "destination": "/login",   "type": 301 },
      { "source": "/app.html",     "destination": "/app",     "type": 301 },
      { "source": "/admin.html",   "destination": "/admin",   "type": 301 },
      { "source": "/manual.html",  "destination": "/manual",  "type": 301 }
    ],
    "rewrites": [
      { "source": "/landing", "destination": "/landing.html" },
      { "source": "/login",   "destination": "/login.html" },
      { "source": "/app",     "destination": "/app.html" },
      { "source": "/manual",  "destination": "/manual.html" },
      { "source": "/admin",   "destination": "/admin.html" }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net; img-src 'self' data: https://*.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; frame-ancestors 'none'" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
